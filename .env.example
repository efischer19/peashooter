# Copy to .env (git-ignored). Variables already set in the environment win; ~ is expanded.

# Optional path overrides (defaults: season.toml and data/peashooter.db next to the code)
# PEASHOOTER_SEASON=/path/to/season.toml
# PEASHOOTER_DB=/path/to/peashooter.db

# Google (see README). Keep these files outside the repo.
# GOOGLE_CLIENT_SECRET_FILE=~/.config/peashooter/client_secret.json
# GOOGLE_TOKEN_FILE=~/.config/peashooter/token.json
# PEASHOOTER_SHEET_ID=      # from the Sheet URL: docs.google.com/spreadsheets/d/<this part>/edit
# PEASHOOTER_FORM_ID=       # from the Form's edit URL: docs.google.com/forms/d/<this part>/edit

# Slack (see README): the bot token and the channel to post in (a test channel first, then the real one)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123ABCD

# Public scoreboard (optional): where `admin.py site` output is published; the digest links to it
# PEASHOOTER_SITE_URL=https://example.com/peashooter

# Pick helper (`admin.py picker`). Recorded by google_form.py whenever it opens, closes or checks the form:
# the responder URL, the prefill entry ids and the week the form is open for ("" while closed).
# PEASHOOTER_FORM_URL=…
# PEASHOOTER_FORM_NAME_ENTRY=…
# PEASHOOTER_FORM_WEEK_ENTRY=…
# PEASHOOTER_FORM_PICKS_ENTRY=…
# PEASHOOTER_FORM_WEEK=…
# Only once the pick helper sits behind a login (e.g. Cloudflare Access): put the form link and the roster's
# names on the page, and let signed-in members submit from it.
# PEASHOOTER_PICKER_FORM=1
